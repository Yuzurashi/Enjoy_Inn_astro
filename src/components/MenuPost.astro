---
const { menuTitle, dish, price } = Astro.props;
---

<!-- Layout of menu.md -->
<div class="flex flex-col pb-4 px-5">
  <h3 class="text-base font-bold">{menuTitle}</h3>
  <div class="flex">
    <div class="flex flex-col">
      <p class="text-base">{dish}</p>
    </div>
    <div class="flex flex-col ml-auto">
      <p class="text-base">${price}</p>
    </div>
  </div>
</div>
