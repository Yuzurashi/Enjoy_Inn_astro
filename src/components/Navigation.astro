---
import Menu from "../components/Menu.astro";
import "../../tailwind/config.css";

const pageTitle = "The Enjoy Inn Chinese Restaurant";

const buttonStyle =
  "hover:brightness-70 rounded-full px-4 py-2 text-sm font-semibold cursor-pointer select-none";
---

<header class="flex justify-center py-3 shadow-lg bg-red-800 text-white">
  <section class="flex flex-col sm:flex-row items-center justify-between align-center w-full px-7 max-w-5xl gap-3">
    <a href="/" class="cursor-pointer select-none flex items-center gap-3">
      <img src="./images/logo.svg" alt="logo image" class="" />
      <p class="font-bold text-2xl">{pageTitle}</p>
    </a>
    <Menu />
    <div class="hidden md:flex gap-3">
      <a class={buttonStyle} href="/">
        Home
      </a>
      <a class={buttonStyle} href="/menu">
        Menu
      </a>
      <a class={buttonStyle} href="/blog">
        Blog
      </a>
    </div>
  </section>
</header>
