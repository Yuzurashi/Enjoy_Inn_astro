---
import Menu from "./Menu.astro";
import Navigation from "./Navigation.astro";
import ThemeIcon from "../components/ThemeIcon.astro";

const pageTitle = "The Enjoy Inn Chinese Restaurant";
---

<header class="flex justify-center py-3 shadow-lg bg-primary text-white">
  <section class="flex flex-col sm:flex-row items-center justify-between align-center w-full px-7 max-w-5xl gap-3">
    <a href="/" class="cursor-pointer select-none flex items-center gap-3">
      <img src="./images/logo.svg" alt="logo image" class="" />
      <p class="font-bold text-2xl">{pageTitle}</p>
    </a>
    <div class="flex justify-between">
      <ThemeIcon /> <!-- Dark/Light mode -->
      <Menu />
    </div>
    <Navigation />
  </section>
</header>
