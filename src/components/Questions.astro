---
import QuestionPost from "../components/QuestionsPost.astro";
const allQuestions = Object.values(
  import.meta.glob("../pages/questions/*.md", { eager: true }),
);
---

<!-- Frequent Questions -->
<section class="flex flex-col gap-3 w-full max-w-5xl my-10 px-5 items-center bg-secondary text-white">
  <div class="py-5 gap-1">
    <div class="mt-5 flex flex-col">
      <h3 class="text-2xl font-bold mb-5">Frequently asked Questions</h3>
    </div>

    <!-- Listing all the question.md -->
    {allQuestions.map((post: any) => (
      <QuestionPost
        question={post.frontmatter.question}
        answer={post.frontmatter.answer}
      />
    ))}
  </div>
</section>
