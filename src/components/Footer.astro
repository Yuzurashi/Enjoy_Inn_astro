---
import Social from "./Social.astro";

const pageTitle = "The Enjoy Inn Chinese Restaurant";
const buttonStyle =
  "hover:brightness-70 rounded-full px-4 py-2 text-sm font-semibold cursor-pointer select-none";

// Column Titles
const columnTitles = "text-base font-italic opacity-80";

// Column 2 Buttons
const pageButtons = "text-2xl font-italic mt-auto";
---

<!-- Footer  -->
<footer class="flex bottom-0 left-0 w-full justify-center py-3 bg-primary text-white">
  <section class="flex flex-col sm:flex-row my-10 w-full px-7 max-w-7xl">
    <!-- Column 1 -->
    <div class="flex flex-col flex-1 bg-green-700">
      <a
        href="/"
        class="flex flex-col cursor-pointer select-none items-center gap-3"
      >
        <img
          src="../../public/images/logo_pot_fill.svg"
          alt="Enjoy Inn logo image"
          class="w-2/3"
        />
        <p class="font-bold text-2xl">{pageTitle}</p>
      </a>
    </div>

    <!-- Column 2 -->
    <div class="flex flex-col flex-1 bg-green-800">
      <!-- PAGE -->
      <div class="flex flex-col gap-5 mx-auto bg-orange-700">
        <h3 class={columnTitles}>PAGE</h3>
        <a class={pageButtons} href="/">
          Home
        </a>
        <a class={pageButtons} href="/menu">
          Menu
        </a>
        <a class={pageButtons} href="/menu">
          MenuMenuMenu
        </a>
        <a class={pageButtons} href="/menu">
          MenuMenuMenuMenu
        </a>
        <a class={pageButtons} href="/menu">
          MenuMenu
        </a>

        <!-- SOCIALS -->
        <div class="flex flex-col gap-5">
          <h3 class={columnTitles}>SOCIALS</h3>
          <a
            class="flex flex-row"
            href="https://www.facebook.com/EnjoyInnChineseRestaurant"
          >
            <!-- <img
                class="w-1/10"
                src="../../public/images/icon_facebook.svg"
                alt="facebook logo"
              /> -->
            <p class="flex my-auto">facebook</p>
          </a>
          <!-- <Social platform="facebook" username="EnjoyInnChineseRestaurant" /> -->
        </div>
      </div>
    </div>

    <!-- Column 3 -->
    <div class="flex flex-col flex-1 bg-green-700">
      <div class="flex flex-col gap-5 mx-auto">
        <h3 class={columnTitles}>CONTACT</h3>
        <div class="flex flex-row w-100 my-auto">
          <img
            src="../../public/images/icon_phone.svg"
            alt="icon of phone"
            class="w-1/15 mr-5"
          />

          <a class={pageButtons} href="tel:9250 8618">
            (08) 9250 8618
          </a>
        </div>
        <div class="flex flex-row w-100 my-auto">
          <img
            src="../../public/images/icon_location.svg"
            alt="icon of phone"
            class="w-1/15 mr-5"
          />
          <p class={pageButtons}>LOCATION</p>
        </div>
      </div>
    </div>
  </section>
</footer>
