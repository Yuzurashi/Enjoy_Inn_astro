{
  "name": "enjoy-inn",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tailwind:dev": "npx @tailwindcss/cli -i ./tailwind/config.css -o ./public/css/app.css --watch",
    "tailwind:build": "npx @tailwindcss/cli -i ./tailwind/config.css -o ./public/css/app.css --minify",
    "dev": "concurrently \"node --watch app.js\" \"npm run tailwind:dev\" \"astro dev\"",
    "start": "npm run tailwind:build && node app.js"
  },
  "keywords": [],
  "author": "Jeffrey Chong",
  "license": "ISC",
  "dependencies": {
    "astro": "^7.3.5",
    "concurrently": "^10.0.5",
    "express": "^5.2.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tailwindcss": "^4.3.3"
  }
}
